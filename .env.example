# From `claude setup-token` (uses your Claude subscription). Leave ANTHROPIC_API_KEY unset; it would take precedence.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional override; defaults to claude-sonnet-5
# CLAUDE_MODEL=claude-opus-5

SKYLIGHT_EMAIL=
SKYLIGHT_PASSWORD=
# Required if the account has more than one frame (run `npm run discover`)
SKYLIGHT_FRAME_ID=

# Service-account key JSON (see README), and the shared calendar's ID
# (Google Calendar → calendar settings → Integrate calendar → Calendar ID)
GOOGLE_KEY_FILE=state/google-key.json
GOOGLE_CALENDAR_ID=

# From `npm run discover` (chat.guid of the group thread)
CHAT_GUID=
# Optional: one-to-one chats with the bot to watch as well (comma-separated chat.guid values,
# e.g. any;-;+15551234567). Senders must still be in ALLOWED_HANDLES.
DM_CHAT_GUIDS=
# Comma-separated sender handles allowed to issue commands (phone as +1..., or email)
ALLOWED_HANDLES=
# The Apple ID the bot is signed into Messages with
BOT_HANDLE=
# The name the bot answers to in the chat
BOT_NAME=Homebot

# Optional: weekly school-newsletter digest (Fridays 5pm). Run `npm run gmail-auth` first (see README).
GMAIL_OAUTH_FILE=state/gmail-oauth.json
NEWSLETTER_SENDER=
# How to refer to the sender in chat ("No school newsletter email from Ms. Smith this week.")
NEWSLETTER_FROM_NAME=
# About the child, so the digest keeps only what applies (name, class, school, teacher, programs they are NOT in)
NEWSLETTER_CONTEXT="Sam, in the 3s class at Example Elementary. Teacher: Ms. Smith. Not in Pre-K."

# Optional: Giftster wish lists. One login per family member, named like ALLOWED_HANDLES
# (the bot always uses the account of whoever asked). Needs Google Chrome installed.
# GIFTSTER_ALEX=email:password
# GIFTSTER_SAM=email:password
