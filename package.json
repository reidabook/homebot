{
  "name": "home-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/main.ts",
    "dry-run": "DRY_RUN=1 node --env-file=.env src/main.ts",
    "discover": "node --env-file=.env scripts/discover.ts",
    "gmail-auth": "node --env-file=.env scripts/gmail-auth.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
